# Local Geth private chain defaults.
GETH_RPC_URL=http://127.0.0.1:8545/
GETH_CHAIN_ID=20260618

# Deployer private key. Use the funded account in the Geth genesis block.
# Do not commit real production keys.
PRIVATE_KEY=

# Optional remote EVM network.
RPC_URL=

# 试点建议值：部署时显式确认，1币=1分钟；合约参数不可变。
BLOCKCHAIN_MAX_SUPPLY=20000000
BLOCKCHAIN_LIFETIME_MINT_THRESHOLD=100000
BLOCKCHAIN_GLOBAL_DAILY_MINT_LIMIT=100000
BLOCKCHAIN_ACCOUNT_DAILY_MINT_LIMIT=1440
# 默认部署多签合约；填写操作账户、bytes32域、逗号分隔的独立审批地址及阈值。
GOVERNANCE_OPERATOR=
GOVERNANCE_DOMAIN=
GOVERNANCE_APPROVERS=
GOVERNANCE_THRESHOLD=2
DEPLOY_LEGACY_TIMECOIN=false
